# ============ ProjectDesk Backend Environment ============
# Copy to .env and fill in real values. NEVER commit your real .env.

# Server
PORT=5000
NODE_ENV=development
SERVER_URL=http://localhost:5000

# Database — local MongoDB (replica set for transactions) or MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/projectdesk

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRES_IN=7d

# CORS / client origin (Vite dev server or deployed frontend URL).
# In development the Vite defaults (5173/5174) are always trusted as well.
CLIENT_ORIGIN=http://localhost:5173

# Auth rate limit (requests per 10 min per IP on /api/auth/*). Raise locally when testing.
AUTH_RATE_LIMIT_MAX=40

# Cloudinary (optional — when empty, uploads fall back to local disk storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
